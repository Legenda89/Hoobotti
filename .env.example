# Hoobot environment variables (copy to .env and set as needed)

# Run in simulation mode (separate options file and port)
# SIMULATE=true

# Start without web UI (headless)
# NOWEBUI=true

# Development build and hot-reload behaviour
# DEVELOPMENT=true

# Web server port (default: 5656; simulation uses 5657 when SIMULATE=true)
# PORT=5656

# Optional: Node memory limit is set via npm scripts (e.g. NODE_OPTIONS=--max-old-space-size=8192)
