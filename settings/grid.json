{
  "simulationHistoryYears": 0.5,
  "includeBaseline": true,
  "maxVariants": 25000,
  "axes": [
    {
      "name": "takeProfit.limit",
      "range": { "from": 0.25, "to": 2, "step": 0.25 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "limit": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.minimum",
      "range": { "from": 1.5, "to": 2.5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "minimum": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfitBuy.limit",
      "range": { "from": 0.25, "to": 2, "step": 0.25 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "takeProfitBuy": { "enabled": true, "limit": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "algorithmicAdaptive.atrLookback",
      "range": { "from": 0, "to": 10, "step": 1 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "algorithmicAdaptive": { "atrLookback": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "algorithmicAdaptive.conflictMinShare",
      "range": { "from": 30, "to": 50, "step": 2 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "algorithmicAdaptive": { "conflictMinShare": "$value" }
              }
            ]
          }
        ]
      }
    }
  ]
}
