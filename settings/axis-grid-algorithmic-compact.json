{
  "simulationHistoryYears": 1,
  "includeBaseline": true,
  "maxVariants": 500,
  "axes": [
    {
      "name": "agreement",
      "range": { "from": 62, "to": 74, "step": 6 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [{ "agreement": "$value" }]
          }
        ]
      }
    },
    {
      "name": "algorithmicAdaptive.conflictMinShare",
      "range": { "from": 36, "to": 40, "step": 4 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "algorithmicAdaptive": {
                  "enabled": true,
                  "conflictMinShare": "$value"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.minimum",
      "range": { "from": 2, "to": 3, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "minimum": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.drop",
      "range": { "from": 0.06, "to": 0.1, "step": 0.04 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "drop": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "stopLoss.pnl",
      "range": { "from": -3.5, "to": -3, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "stopLoss": { "enabled": true, "pnl": "$value" }
              }
            ]
          }
        ]
      }
    }
  ]
}
