{
  "simulationHistoryYears": 1,
  "includeBaseline": true,
  "maxVariants": 1500,
  "axes": [
    {
      "name": "stopLoss.pnl",
      "range": { "from": -5.5, "to": -4.5, "step": 0.25 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "stopLoss": { "pnl": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.minimum",
      "range": { "from": 2.5, "to": 3.5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": { "minimum": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.drop",
      "range": { "from": 0.15, "to": 0.25, "step": 0.05 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": { "drop": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.limit",
      "range": { "from": 0.15, "to": 0.25, "step": 0.05 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": { "limit": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.forceAfterDrop",
      "range": { "from": 0.15, "to": 0.25, "step": 0.05 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": { "forceAfterDrop": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.forceMinProfit",
      "range": { "from": 0.75, "to": 1.25, "step": 0.25 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": { "forceMinProfit": "$value" }
              }
            ]
          }
        ]
      }
    }
  ]
}
