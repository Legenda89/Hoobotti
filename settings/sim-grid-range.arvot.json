{
  "simulationHistoryYears": 1,
  "includeBaseline": true,
  "maxVariants": 50000000,
  "axes": [
    {
      "name": "takeProfit.minimum",
      "range": { "from": 2, "to": 5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "minimum": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "profit.minimumSell",
      "range": { "from": 2, "to": 5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "profit": { "enabled": true, "minimumSell": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "profit.minimumBuy",
      "range": { "from": -5, "to": 5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "profit": { "enabled": true, "minimumBuy": "$value" }
              }
            ]
          }
        ]
      }
    }

  ]
}
