{
  "simulationHistoryYears": 1,
  "includeBaseline": true,
  "maxVariants": 200,
  "axes": [
    {
      "name": "takeProfitBuy.drop",
      "range": { "from": 0.1, "to": 0.18, "step": 0.02 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfitBuy": {
                  "enabled": true,
                  "drop": "$value",
                  "limit": 0.35
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfitBuy.limit",
      "range": { "from": 0.25, "to": 0.4, "step": 0.05 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfitBuy": {
                  "enabled": true,
                  "limit": "$value"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.minimum",
      "range": { "from": 0.7, "to": 1.0, "step": 0.1 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "minimum": "$value" },
                "takeProfitBuy": { "enabled": true, "minimum": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.partialClose.fraction",
      "range": { "from": 0.35, "to": 0.5, "step": 0.05 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": {
                  "partialClose": { "enabled": true, "fraction": "$value" }
                },
                "takeProfitBuy": {
                  "partialClose": { "enabled": true, "fraction": "$value" }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
