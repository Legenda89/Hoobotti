{
  "simulationHistoryYears": 1,
  "includeBaseline": true,
  "maxVariants": 50000000,
  "axes": [
    {
      "name": "stopLoss.pnl",
      "range": { "from": -10, "to": -2, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "stopLoss": { "enabled": true, "pnl": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "stopLossBuy.pnl",
      "range": { "from": -10, "to": 2, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "stopLossBuy": { "enabled": true, "pnl": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.forceMinProfit",
      "range": { "from": 0.5, "to": 5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "forceMinProfit": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "forcedExit.minProfit",
      "range": { "from": 0.5, "to": 5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "forcedExit": { "enabled": true, "minProfit": "$value" }
              }
            ]
          }
        ]
      }
    }
  ]
}
