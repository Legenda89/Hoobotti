{
  "simulationHistoryYears": 0.5,
  "includeBaseline": true,
  "maxVariants": 150000,
  "axes": [
    {
      "name": "algorithmicAdaptive.maxCashCandles",
      "range": { "from": 96, "to": 384, "step": 96 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "algorithmicAdaptive": { "maxCashCandles": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "algorithmicAdaptive.maxLongCandles",
      "range": { "from": 96, "to": 288, "step": 96 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "algorithmicAdaptive": { "maxLongCandles": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "algorithmicAdaptive.trendCounterPenalty",
      "range": { "from": 0, "to": 16, "step": 8 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "algorithmicAdaptive": { "trendCounterPenalty": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.minimum",
      "range": { "from": 1, "to": 2.5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "minimum": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.drop",
      "range": { "from": 0.05, "to": 0.14, "step": 0.03 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "drop": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "takeProfit.limit",
      "range": { "from": 0.5, "to": 2, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "limit": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "stopLoss.pnl",
      "range": { "from": -4, "to": -2.5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [
              {
                "stopLoss": { "enabled": true, "stopTrading": false, "pnl": "$value" }
              }
            ]
          }
        ]
      }
    }
  ]
}
