{
  "simulationHistoryYears": 0.5,
  "includeBaseline": true,
  "maxVariants": 240,
  "axes": [
    {
      "name": "takeProfit.minimum",
      "range": { "from": 0.4, "to": 0.8, "step": 0.2 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [{ "takeProfit": { "enabled": true, "minimum": "$value" } }]
          }
        ]
      }
    },
    {
      "name": "takeProfit.limit",
      "range": { "from": 0.3, "to": 0.5, "step": 0.2 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [{ "takeProfit": { "enabled": true, "limit": "$value" } }]
          }
        ]
      }
    },
    {
      "name": "takeProfitBuy.minimum",
      "range": { "from": 0.8, "to": 1.2, "step": 0.2 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [{ "takeProfitBuy": { "enabled": true, "minimum": "$value" } }]
          }
        ]
      }
    },
    {
      "name": "scoutConfirm.scoutMinShare",
      "range": { "from": 35, "to": 45, "step": 10 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [{ "scoutConfirm": { "enabled": true, "scoutMinShare": "$value" } }]
          }
        ]
      }
    },
    {
      "name": "agreement",
      "range": { "from": 58, "to": 62, "step": 4 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [{ "agreement": "$value" }]
          }
        ]
      }
    },
    {
      "name": "stopLoss.pnl",
      "range": { "from": -2, "to": -1.5, "step": 0.5 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "mode": "algorithmic",
            "symbols": [{ "stopLoss": { "enabled": true, "pnl": "$value" } }]
          }
        ]
      }
    }
  ]
}
