    {
      "name": "takeProfit.minimum",
      "range": { "from": 0.1, "to": 1.0, "step": 0.1 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "takeProfit": { "enabled": true, "minimum": "$value" }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "stopLoss.pnl",
      "range": { "from": -5, "to": -1, "step": 1 },
      "template": {
        "exchanges": [
          {
            "name": "binance",
            "symbols": [
              {
                "stopLoss": { "enabled": true, "stopTrading": false, "pnl": "$value" }
              }
            ]
          }
        ]
      }
    }
  ]
